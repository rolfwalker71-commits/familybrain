OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CHAT_PROVIDER=
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATABASE_PATH=./data/familybrain.sqlite
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=familybrain_chunks
FAMILYBRAIN_USERNAME=admin
FAMILYBRAIN_PASSWORD=change-this-development-password
FAMILYBRAIN_SESSION_SECRET=change-this-to-at-least-32-random-characters

# Web Push — npm run push:vapid  (or docs/web-push.md for Docker)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Public HTTPS origin (OAuth redirect) — production example:
# APP_PUBLIC_URL=https://buddyapp.rolfwalker.ch

# Optional: OpenAI key/model can also be set in the UI (Einstellungen).
# UI settings in SQLite take precedence over these env vars.

# FinanzBrain mail (SMTP, e.g. iCloud+) — also in Einstellungen → E-Mail
# SMTP_HOST=smtp.mail.me.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=name@icloud.com
# SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=FamilyBrain <name@icloud.com>

# Docker: copy `.env.example` → `.env` and see README “Docker”.
